{
  "name": "chrome-postman",
  "version": "1.0.0",
  "private": true,
  "description": "基于 Chrome 扩展 (Manifest V3) 实现的类 Postman API 调试工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:sw",
    "build:sw": "vite build --config vite.sw.config.ts",
    "build:all": "npm run icons && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-verify.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "pack": "npm run build:all && npm run icons && node scripts/pack.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@uiw/react-codemirror": "^4.23.13",
    "quickjs-emscripten": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
